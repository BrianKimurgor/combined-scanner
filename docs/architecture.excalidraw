      "isDeleted": false,
      "boundElements": [],
      "updated": 1793353634411,
      "link": null,
      "locked": false,
      "text": "100%  minus points lost per finding that counts:\ncritical  -10     high  -5     medium  -2     low  -0.5     info  0\nNever below 0%.  Shows n/a if no scanner managed to run.\nExample: 1 high + 2 medium = 100 - 5 - 4 = 91%",
      "originalText": "100%  minus points lost per finding that counts:\ncritical  -10     high  -5     medium  -2     low  -0.5     info  0\nNever below 0%.  Shows n/a if no scanner managed to run.\nExample: 1 high + 2 medium = 100 - 5 - 4 = 91%",
      "fontSize": 16,
